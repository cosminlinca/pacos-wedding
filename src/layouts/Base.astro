---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-ext-500.css';
import '../styles/global.css';

import type { Locale } from '../lib/i18n';
import { switchLocalePath } from '../lib/i18n';
import { withBase } from '../lib/paths';

interface Props {
  locale: Locale;
  t: (key: string) => string;
  /** Flip to true to keep the page out of search indexes. */
  noindex?: boolean;
}

const { locale, t, noindex = false } = Astro.props;

const site = Astro.site; // https://cosminlinca.github.io
const abs = (path: string): string => (site ? new URL(path, site).href : path);

const roPath = switchLocalePath(Astro.url, 'ro');
const enPath = switchLocalePath(Astro.url, 'en');
const canonical = abs(locale === 'ro' ? roPath : enPath);

const ogImage = abs(withBase('/og-image.png'));
const ogLocale = locale === 'ro' ? 'ro_RO' : 'en_GB';
const ogLocaleAlt = locale === 'ro' ? 'en_GB' : 'ro_RO';

const title = t('meta.title');
const description = t('meta.description');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Pati & Cos',
  startDate: '2027-08-21',
  endDate: '2027-08-21',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  description,
  image: [ogImage],
  url: canonical,
  location: {
    '@type': 'Place',
    name: 'Wonderland — Sala Riviera',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Cluj-Napoca',
      addressCountry: 'RO',
    },
  },
};
---

<!doctype html>
<html lang={t('htmlLang')} dir={t('dir')} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ro" href={abs(roPath)} />
    <link rel="alternate" hreflang="en" href={abs(enPath)} />
    <link rel="alternate" hreflang="x-default" href={abs(roPath)} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#F6F1E7" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pati & Cos" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.ogAlt')} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t('meta.ogAlt')} />

    <meta name="generator" content={Astro.generator} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">{t('skipToContent')}</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />

    <script>
      // Reveal-on-scroll. No-op (everything shown) when motion is reduced or
      // IntersectionObserver is missing.
      const els = document.querySelectorAll<HTMLElement>(
        '[data-reveal], [data-motion]'
      );
      const show = (el: Element) => el.classList.add('is-visible');
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach(show);
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              show(entry.target);
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));

        // Safety net: never leave content hidden if the observer is starved
        // (very slow device, background tab on load, odd viewport). Only what
        // is already on screen gets rescued — anything further down keeps its
        // reveal for when the reader actually scrolls to it.
        window.setTimeout(() => {
          els.forEach((el) => {
            if (el.classList.contains('is-visible')) return;
            if (el.getBoundingClientRect().top >= window.innerHeight) return;
            show(el);
            io.unobserve(el);
          });
        }, 1600);
      }
    </script>
  </body>
</html>
