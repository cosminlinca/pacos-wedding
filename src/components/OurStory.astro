---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { STORY_CHAPTERS } from '../lib/invitation';
import Figure from './Figure.astro';
import StoryMap from './StoryMap.astro';

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/story/*/*.jpg',
  { eager: true }
);
const chapters = await Promise.all(
  STORY_CHAPTERS.map(async (id) => {
    const sources = Object.entries(modules)
      .filter(([path]) => path.includes(`/story/${id}/`))
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([, mod]) => mod.default);
    const title = t(`story.${id}.title`);
    // Short description shown when the book opens; empty hides it.
    const text = t(`story.${id}.text`);
    // Full-size versions for the photo viewer (and the no-JS link target).
    const photos = await Promise.all(
      sources.map(async (src, index) => ({
        src,
        full: (
          await getImage({
            src,
            width: Math.min(1600, src.width),
            format: 'webp',
            quality: 78,
          })
        ).src,
        alt: t('story.gallery.alt')
          .replace('{title}', title)
          .replace('{n}', String(index + 1))
          .replace('{total}', String(sources.length)),
      }))
    );
    return { id, title, text, photos };
  })
).then((all) => all.filter(({ photos }) => photos.length > 0));
---

<section class="invitation-section" id="story" aria-labelledby="story-heading">
  <div class="container invitation-stack">
    <p class="eyebrow" data-reveal>{t('story.eyebrow')}</p>
    <h2 class="section-heading" id="story-heading" data-reveal>
      {t('story.heading')}
    </h2>
    <p class="measure detail-note" data-reveal>{t('story.intro')}</p>
    <StoryMap t={t} />
    <ol class="story__timeline" role="list">
      {
        chapters.map(({ title, text, photos }, index) => (
          <li class="story__entry">
            <details class="book story__chapter" data-reveal>
              <summary class="book__cover">
                <span class="book__number">
                  {t('story.episode').replace('{n}', String(index + 1))}
                </span>
                <h3 class="book__title">{title}</h3>
                <span class="book__hint">{t('story.open')}</span>
              </summary>
              <div class="book__inside">
                {text && <p class="book__text">{text}</p>}
                <ul class="book__pages" role="list" tabindex="0">
                  {photos.map((photo) => (
                    <li class="book__page">
                      <a
                        class="story__polaroid"
                        href={photo.full}
                        data-full={photo.full}
                      >
                        <Figure
                          src={photo.src}
                          alt={photo.alt}
                          ratio="1 / 1"
                          widths={[360, 540, 720]}
                          sizes="(min-width: 45rem) 22rem, 80vw"
                          quality={65}
                          loading="lazy"
                        />
                      </a>
                    </li>
                  ))}
                </ul>
                <div class="book__nav">
                  <button
                    type="button"
                    class="book__arrow"
                    data-dir="-1"
                    disabled
                    aria-label={t('story.prev')}
                  >
                    ‹
                  </button>
                  <span class="book__dots" aria-hidden="true">
                    {photos.map((_, i) => (
                      <span
                        class:list={['book__dot', { 'is-active': i === 0 }]}
                      />
                    ))}
                  </span>
                  <button
                    type="button"
                    class="book__arrow"
                    data-dir="1"
                    aria-label={t('story.next')}
                  >
                    ›
                  </button>
                </div>
              </div>
            </details>
          </li>
        ))
      }
    </ol>
  </div>

  <dialog class="lightbox" aria-label={t('story.lightbox.label')}>
    <img class="lightbox__img" alt="" />
    <p class="lightbox__count" aria-live="polite"></p>
    <button
      type="button"
      class="lightbox__btn lightbox__close"
      aria-label={t('story.lightbox.close')}
    >
      ×
    </button>
    <button
      type="button"
      class="lightbox__btn lightbox__prev"
      data-dir="-1"
      aria-label={t('story.lightbox.prev')}
    >
      ‹
    </button>
    <button
      type="button"
      class="lightbox__btn lightbox__next"
      data-dir="1"
      aria-label={t('story.lightbox.next')}
    >
      ›
    </button>
  </dialog>
</section>

<script>
  // Photo books: page dots and arrows. On wide screens two pages are visible
  // at once, so both of their dots light up.
  document.querySelectorAll<HTMLElement>('.book').forEach((book) => {
    const pages = book.querySelector<HTMLElement>('.book__pages');
    const dots = book.querySelectorAll<HTMLElement>('.book__dot');
    const prev = book.querySelector<HTMLButtonElement>('[data-dir="-1"]');
    const next = book.querySelector<HTMLButtonElement>('[data-dir="1"]');
    if (!pages || !prev || !next) return;
    const items = pages.children.length;
    const pageWidth = () => pages.scrollWidth / items;
    const update = () => {
      const width = pageWidth();
      if (!width) return;
      const perView = Math.max(1, Math.round(pages.clientWidth / width));
      const first = Math.min(items, Math.round(pages.scrollLeft / width) + 1);
      const last = Math.min(items, first + perView - 1);
      dots.forEach((dot, index) =>
        dot.classList.toggle('is-active', index >= first - 1 && index < last)
      );
      const max = pages.scrollWidth - pages.clientWidth;
      prev.disabled = pages.scrollLeft <= 1;
      next.disabled = pages.scrollLeft >= max - 1;
    };
    pages.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    book.addEventListener('toggle', update);
    [prev, next].forEach((btn) => {
      btn.addEventListener('click', () => {
        pages.scrollBy({
          left: Number(btn.dataset.dir) * pageWidth(),
          behavior: 'smooth',
        });
      });
    });
    update();
  });

  // Full-size photo viewer. Without JS the polaroids are plain links to the
  // full-size image.
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const img = dialog?.querySelector<HTMLImageElement>('.lightbox__img');
  const counter = dialog?.querySelector<HTMLElement>('.lightbox__count');
  if (dialog && img && counter && 'showModal' in dialog) {
    let set: HTMLAnchorElement[] = [];
    let current = 0;

    const show = (index: number) => {
      current = (index + set.length) % set.length;
      const link = set[current];
      img.src = link.dataset.full ?? link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      counter.textContent = `${current + 1} / ${set.length}`;
    };

    document
      .querySelectorAll<HTMLAnchorElement>('.story__polaroid')
      .forEach((link) => {
        link.addEventListener('click', (event) => {
          event.preventDefault();
          const book = link.closest('.book');
          set = Array.from(
            book?.querySelectorAll<HTMLAnchorElement>('.story__polaroid') ?? []
          );
          show(set.indexOf(link));
          dialog.showModal();
        });
      });

    dialog
      .querySelector('.lightbox__close')
      ?.addEventListener('click', () => dialog.close());
    dialog
      .querySelectorAll<HTMLButtonElement>('[data-dir]')
      .forEach((btn) =>
        btn.addEventListener('click', () =>
          show(current + Number(btn.dataset.dir))
        )
      );
    // Click on the backdrop closes.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });
    // Swipe left/right on touch screens.
    let startX: number | null = null;
    dialog.addEventListener(
      'touchstart',
      (event) => (startX = event.touches[0]?.clientX ?? null),
      { passive: true }
    );
    dialog.addEventListener('touchend', (event) => {
      const endX = event.changedTouches[0]?.clientX;
      if (startX === null || endX === undefined) return;
      const dx = endX - startX;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
      startX = null;
    });
    dialog.addEventListener('close', () => img.removeAttribute('src'));
  }
</script>

<style>
  .story__timeline {
    width: 100%;
    list-style: none;
    padding: 0 0 0 var(--space-lg);
    margin-top: var(--space-xl);
    border-left: var(--hairline);
  }

  .story__entry {
    position: relative;
  }

  .story__entry + .story__entry {
    margin-top: var(--space-2xl);
  }

  .story__entry::before {
    content: '';
    position: absolute;
    top: var(--space-xl);
    left: calc(-1 * var(--space-lg) - 0.3rem);
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--dot-1);
  }

  .story__entry:nth-child(3n + 2)::before {
    background: var(--dot-2);
  }

  .story__entry:nth-child(3n)::before {
    background: var(--dot-3);
  }

  .book {
    max-width: 46rem;
    perspective: 1400px;
  }

  .book__cover {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-xl) var(--space-xl) var(--space-xl)
      calc(var(--space-xl) + 1rem);
    cursor: pointer;
    list-style: none;
    color: var(--cream);
    background:
      repeating-linear-gradient(
        90deg,
        rgb(0 0 0 / 0.04) 0 2px,
        transparent 2px 9px
      ),
      linear-gradient(135deg, var(--purple) 0%, var(--purple-deep) 100%);
    border-radius: 3px 10px 10px 3px;
    box-shadow:
      inset 0.9rem 0 0 rgb(0 0 0 / 0.22),
      inset 1rem 0 0 rgb(255 255 255 / 0.08),
      0 0.75rem 1.5rem rgb(var(--accent-rgb) / 0.28);
    transition: transform 320ms var(--ease-editorial);
  }

  .book__cover::before {
    content: '';
    position: absolute;
    inset: var(--space-sm) var(--space-sm) var(--space-sm)
      calc(var(--space-sm) + 1rem);
    border: 3px solid var(--frame);
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px var(--frame-shade);
    pointer-events: none;
  }

  .book__cover::-webkit-details-marker {
    display: none;
  }

  .book__cover:hover,
  .book__cover:focus-visible {
    transform: translateY(-3px);
  }

  .book__number {
    font-family: var(--font-logo);
    font-size: var(--step--1);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--frame);
  }

  .book__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .book__hint {
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .book__hint::after {
    content: ' →';
  }

  .book[open] .book__cover {
    transform: none;
    border-radius: 3px 10px 0 0;
  }

  .book[open] .book__hint {
    visibility: hidden;
  }

  .book__text {
    max-width: var(--measure);
    margin: var(--space-sm) auto 0;
    padding-inline: var(--space-lg);
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--step-1);
    line-height: 1.45;
    text-align: center;
    text-wrap: pretty;
    color: var(--accent-ink);
  }

  .book__inside {
    padding: var(--space-lg) var(--space-sm) var(--space-md);
    background:
      linear-gradient(90deg, rgb(var(--accent-rgb) / 0.14), transparent 3rem),
      var(--bg-sink);
    border-radius: 0 0 10px 3px;
    box-shadow: 0 0.75rem 1.5rem rgb(var(--accent-rgb) / 0.18);
    transform-origin: top center;
  }

  .book__pages {
    display: flex;
    margin: 0;
    padding: var(--space-md) 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .book__pages::-webkit-scrollbar {
    display: none;
  }

  .book__page {
    flex: 0 0 100%;
    display: grid;
    place-items: center;
    padding: var(--space-sm) var(--space-lg);
    scroll-snap-align: center;
  }

  .story__polaroid {
    display: block;
    width: min(100%, 22rem);
    cursor: zoom-in;
    padding: var(--space-sm) var(--space-sm) var(--space-xl);
    background: #fffdf8;
    box-shadow:
      0 1px 2px rgb(var(--accent-rgb) / 0.18),
      0 0.75rem 1.5rem rgb(var(--accent-rgb) / 0.16);
  }

  .book__page:nth-child(odd) .story__polaroid {
    transform: rotate(-1.5deg);
  }

  .book__page:nth-child(even) .story__polaroid {
    transform: rotate(1.2deg);
  }

  .story__polaroid :global(.figure) {
    width: 100%;
  }

  .book__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
  }

  .book__arrow {
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent-soft);
    border-radius: 50%;
    cursor: pointer;
  }

  .book__arrow:hover:not(:disabled) {
    background: rgb(var(--accent-rgb) / 0.08);
  }

  .book__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: var(--space-xl) var(--space-sm);
    border: 0;
    background: rgb(20 18 14 / 0.94);
    color: #fffdf8;
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
  }

  .lightbox::backdrop {
    background: rgb(20 18 14 / 0.6);
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100dvh - 7rem);
    object-fit: contain;
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.5);
  }

  .lightbox__count {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
  }

  .lightbox__btn {
    position: absolute;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.8rem;
    line-height: 1;
    color: inherit;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 50%;
    cursor: pointer;
  }

  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.18);
  }

  .lightbox__close {
    top: var(--space-sm);
    right: var(--space-sm);
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__prev {
    left: var(--space-sm);
  }

  .lightbox__next {
    right: var(--space-sm);
  }

  /* One dot per photo; the ones on screen light up in the logo colours. */
  .book__dots {
    display: flex;
    gap: 0.45rem;
  }

  .book__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent-soft);
    transition:
      background 220ms var(--ease-editorial),
      scale 220ms var(--ease-editorial);
  }

  .book__dot.is-active {
    background: var(--dot-1);
    scale: 1.25;
  }

  .book__dot.is-active:nth-child(3n + 2) {
    background: var(--dot-2);
  }

  .book__dot.is-active:nth-child(3n) {
    background: var(--dot-3);
  }

  @media (min-width: 45rem) {
    .book__page {
      flex-basis: 50%;
    }
  }
</style>
