---
import type { Locale } from '../lib/i18n';
import { formatWeddingDate } from '../lib/datetime';
import Figure from './Figure.astro';
import Countdown from './Countdown.astro';
import AddToCalendar from './AddToCalendar.astro';
import ScrollCue from './ScrollCue.astro';
import couplePhoto from '../assets/couple-path.jpg';

interface Props {
  locale: Locale;
  t: (key: string) => string;
}

const { locale, t } = Astro.props;
const dateSentence = t('hero.dateSentence') || formatWeddingDate(locale);
---

<section class="hero" aria-labelledby="couple">
  <div class="hero__media" aria-hidden="true">
    <div class="hero__media-inner">
      {
        /* Decorative: the same photo, blurred to a warm wash. The readable
          version lives in the Portrait section, so alt is empty here. */
      }
      <Figure
        fill
        src={couplePhoto}
        alt=""
        position="50% 56%"
        widths={[480, 720, 900]}
        sizes="100vw"
        quality={68}
        loading="eager"
        class="hero__figure"
      />
    </div>
    <div class="hero__scrim"></div>
  </div>

  <div class="container hero__content">
    <p class="eyebrow hero__eyebrow" data-reveal style="--reveal-index: 0">
      {t('hero.eyebrow')}
    </p>

    <h1 class="hero__names" id="couple" data-motion>
      <span class="hero__name">
        <span class="hero__rise" style="--i: 0">{t('hero.nameA')}</span>
      </span>
      <span class="hero__pair">
        <span class="hero__amp">
          <span class="hero__rise" style="--i: 1">{t('hero.and')}</span>
        </span>
        <span class="hero__name">
          <span class="hero__rise" style="--i: 2">{t('hero.nameB')}</span>
        </span>
      </span>
    </h1>

    <div class="hero__meta" data-reveal style="--reveal-index: 2">
      <p class="hero__date">{t('hero.date')}</p>
      <hr class="rule" />
      <p class="hero__place">{t('hero.place')}</p>
      <p class="hero__sentence">{dateSentence}</p>
    </div>

    <div class="hero__countdown" data-reveal style="--reveal-index: 3">
      <Countdown locale={locale} t={t} />
    </div>

    <div class="hero__cta" data-reveal style="--reveal-index: 4">
      <AddToCalendar locale={locale} t={t} />
    </div>
  </div>

  <div class="hero__cue">
    <ScrollCue t={t} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-block: clamp(5.5rem, 3.5rem + 10vh, 8rem)
      clamp(4rem, 2.5rem + 7vh, 6rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* Generous bleed: the blur radius and the Ken Burns drift both eat into the
     edges, and neither may ever expose the page background. */
  .hero__media-inner {
    position: absolute;
    inset: -10%;
    will-change: transform;
  }

  .hero__media-inner :global(.figure__img) {
    filter: blur(9px) saturate(0.95);
    transform: scale(1.06);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      90% 70% at 50% 42%,
      rgb(var(--bg-rgb) / 0.42),
      rgb(var(--bg-rgb) / 0.66) 70%,
      rgb(var(--bg-rgb) / 0.86) 100%
    );
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.35rem, 1rem + 2vw, 2.25rem);
    text-align: center;
  }

  .hero__eyebrow {
    margin: 0;
  }

  .hero__names {
    margin: 0;
    font-optical-sizing: auto;
    font-variation-settings:
      'SOFT' 40,
      'WONK' 1,
      'opsz' 144;
    font-size: var(--step-4);
    font-weight: 380;
    letter-spacing: -0.01em;
    color: var(--ink);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.08em 0.28em;
  }

  /* Keeps the break as "Pati" / "& Cos" — the ampersand never orphans. */
  .hero__pair {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    white-space: nowrap;
  }

  /* Masks for the rise-in: the padding gives ascenders and descenders room,
     the matching negative margin keeps the baselines exactly where they were. */
  .hero__name,
  .hero__amp {
    display: block;
    overflow: hidden;
    padding-block: 0.14em 0.2em;
    margin-block: -0.14em -0.2em;
  }

  .hero__rise {
    display: block;
  }

  .hero__amp {
    font-style: italic;
    font-variation-settings:
      'SOFT' 60,
      'WONK' 1,
      'opsz' 144;
    color: var(--accent);
  }

  .hero__meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .hero__date {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--step-2);
    font-weight: 400;
    color: var(--accent-ink);
  }

  /* Full-strength ink rather than --ink-soft: these sit over the thinnest part
     of the scrim, where the softer grey washed out. No shadow — they should
     read exactly like the rest of the hero type. */
  .hero__place {
    font-size: var(--step-0);
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  .hero__sentence {
    font-size: var(--step--1);
    color: var(--ink);
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: clamp(1.25rem, 0.5rem + 3vh, 2.5rem);
    transform: translateX(-50%);
    z-index: 1;
  }

  @media (max-width: 22rem) {
    .hero__names {
      flex-direction: column;
      gap: 0.05em;
    }

    .hero__pair {
      justify-content: center;
    }
  }
</style>
