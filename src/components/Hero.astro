---
import type { Locale } from '../lib/i18n';
import { formatWeddingDate } from '../lib/datetime';
import Figure from './Figure.astro';
import Countdown from './Countdown.astro';
import AddToCalendar from './AddToCalendar.astro';
import RsvpButton from './RsvpButton.astro';
import ScrollCue from './ScrollCue.astro';
import couplePhoto from '../assets/couple-path.jpg';

interface Props {
  locale: Locale;
  t: (key: string) => string;
}

const { locale, t } = Astro.props;
const dateSentence = t('hero.dateSentence') || formatWeddingDate(locale);
// "Pati" → ["P", "A", "T", "I"]; the dots are drawn between the letters.
const letters = (word: string) => Array.from(word.toLocaleUpperCase(locale));
---

<section class="hero theme-purple" aria-labelledby="couple">
  <div class="container hero__content">
    <div class="hero__text">
      <p class="eyebrow hero__eyebrow" data-reveal style="--reveal-index: 0">
        {t('hero.eyebrow')}
      </p>

      <h1 class="hero__names dotted" id="couple" data-motion>
        <span class="visually-hidden">{t('hero.names')}</span>
        <span class="hero__name" aria-hidden="true">
          <span class="hero__rise" style="--i: 0">
            {
              letters(t('hero.nameA')).map((letter, index) => (
                <>
                  {index > 0 && <span class="dotted__dot" />}
                  {letter}
                </>
              ))
            }
          </span>
        </span>
        <span class="hero__pair" aria-hidden="true">
          <span class="hero__amp couple-amp">
            <span class="hero__rise" style="--i: 1">{t('hero.and')}</span>
          </span>
          <span class="hero__name">
            <span class="hero__rise" style="--i: 2">
              {
                letters(t('hero.nameB')).map((letter, index) => (
                  <>
                    {index > 0 && <span class="dotted__dot" />}
                    {letter}
                  </>
                ))
              }
            </span>
          </span>
        </span>
      </h1>

      <div class="hero__meta" data-reveal style="--reveal-index: 2">
        <p class="hero__date">{t('hero.date')}</p>
        <hr class="rule" />
        <p class="hero__place">{t('hero.place')}</p>
        <p class="hero__sentence">{dateSentence}</p>
      </div>

      <div class="hero__countdown" data-reveal style="--reveal-index: 3">
        <Countdown locale={locale} t={t} />
      </div>

      <div class="hero__cta" data-reveal style="--reveal-index: 4">
        <RsvpButton t={t} />
        <AddToCalendar locale={locale} t={t} />
        <p class="hero__deadline">{t('rsvp.deadline')}</p>
      </div>
    </div>

    <div class="hero__photo" data-reveal style="--reveal-index: 1">
      <div class="peephole">
        <Figure
          src={couplePhoto}
          alt={t('hero.photoAlt')}
          ratio="4 / 5"
          position="50% 58%"
          widths={[360, 540, 720, 900]}
          sizes="(min-width: 60rem) 26rem, 72vw"
          quality={74}
          loading="eager"
        />
      </div>
    </div>
  </div>

  <div class="hero__cue">
    <ScrollCue t={t} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-block: clamp(3rem, 2rem + 6vh, 6rem) clamp(5rem, 3.5rem + 7vh, 7rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__content {
    display: grid;
    justify-items: center;
    gap: clamp(2rem, 1.5rem + 3vw, 3.5rem);
  }

  /* A size container, so the names can scale to fit its width. */
  .hero__text {
    container-type: inline-size;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.35rem, 1rem + 2vw, 2.25rem);
    text-align: center;
  }

  .hero__photo {
    width: min(72vw, 20rem);
  }

  .hero__photo .peephole {
    rotate: 2deg;
  }

  .hero__eyebrow {
    margin: 0;
  }

  /* Always one line: the size tracks the column width (≈8.3em of lettering),
     capped at the display step on wide screens. */
  .hero__names {
    margin: 0;
    font-size: min(var(--step-4), 11.5cqi);
    line-height: 1;
    color: var(--ink);
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.28em;
    white-space: nowrap;
  }

  .hero__amp {
    font-size: 0.8em;
  }

  .hero__pair {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    white-space: nowrap;
  }

  /* Masks for the rise-in: the padding gives ascenders, descenders and the
     slanted letters' overhang room; the matching negative margin keeps the
     layout exactly where it was. */
  .hero__name,
  .hero__amp {
    display: block;
    overflow: hidden;
    padding: 0.14em 0.12em 0.2em;
    margin: -0.14em -0.12em -0.2em;
  }

  .hero__rise {
    display: block;
    white-space: nowrap;
  }

  .hero__meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .hero__date {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--step-2);
    font-weight: 400;
    color: var(--accent-ink);
  }

  .hero__place {
    font-size: var(--step-0);
    letter-spacing: 0.02em;
  }

  .hero__sentence {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: clamp(1.25rem, 0.5rem + 3vh, 2.5rem);
    transform: translateX(-50%);
    z-index: 1;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }

  .hero__deadline {
    flex-basis: 100%;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  @media (min-width: 60rem) {
    .hero__content {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
    }

    .hero__photo {
      width: min(100%, 26rem);
    }
  }
</style>
