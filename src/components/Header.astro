---
import type { Locale } from '../lib/i18n';
import { withBase } from '../lib/paths';
import LangToggle from './LangToggle.astro';
import RsvpButton from './RsvpButton.astro';

interface Props {
  locale: Locale;
  t: (key: string) => string;
}

const { locale, t } = Astro.props;
const homeHref = locale === 'ro' ? withBase('/') : withBase('/en/');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="monogram" href={homeHref} aria-label={t('hero.names')}>
      <span aria-hidden="true">P</span>
      <span class="dotted__dot" aria-hidden="true"></span>
      <span class="couple-amp" aria-hidden="true">&amp;</span>
      <span class="dotted__dot" aria-hidden="true"></span>
      <span aria-hidden="true">C</span>
    </a>
    <nav class="site-header__nav" aria-label={t('nav.sections')}>
      {
        ['story', 'schedule', 'venue'].map((section) => (
          <a href={`#${section}`}>{t(`nav.${section}`)}</a>
        ))
      }
    </nav>
    <div class="site-header__actions">
      <LangToggle locale={locale} t={t} />
      <div class="site-header__rsvp">
        <RsvpButton t={t} outline />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding-block: var(--space-md);
    background: var(--bg);
    border-bottom: 3px solid var(--frame);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .monogram {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 0.12em;
    min-height: 44px;
    font-family: var(--font-names);
    font-weight: 400;
    font-size: var(--step-1);
    line-height: 1.1;
    letter-spacing: 0.04em;
    color: var(--accent-ink);
    text-decoration: none;
  }

  .monogram:hover,
  .monogram:focus-visible {
    color: var(--ink);
  }

  .site-header__nav {
    display: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-width: 0;
  }

  .site-header__actions :global(.lang) {
    flex-shrink: 0;
    letter-spacing: 0.06em;
  }

  .site-header__actions :global(.lang__other) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .site-header__rsvp {
    min-width: 0;
    text-align: center;
  }

  .site-header__rsvp :global(.button) {
    white-space: nowrap;
    padding: 0.65em 0.8em;
    letter-spacing: 0.06em;
  }

  @media (min-width: 40rem) {
    .site-header__inner,
    .site-header__actions {
      gap: var(--space-xl);
    }

    /* The Friends lettering runs wide, so it stays a step below the old
       serif monogram. */
    .monogram {
      font-size: calc(var(--step-1) * 1.15);
    }

    .site-header__rsvp :global(.button) {
      padding-inline: 1.4em;
    }
  }

  @media (min-width: 64rem) {
    .site-header {
      padding-block: var(--space-lg);
    }

    .site-header__nav {
      display: flex;
      align-items: center;
      gap: var(--space-lg);
      margin-left: auto;
      font-size: var(--step--1);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .site-header__nav a {
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--ink-soft);
      text-decoration: none;
    }

    .site-header__nav a:hover,
    .site-header__nav a:focus-visible {
      color: var(--accent-ink);
      text-decoration: underline;
      text-underline-offset: 0.5em;
    }
  }
</style>
