---
import type { Locale } from '../lib/i18n';
import { withBase } from '../lib/paths';
import LangToggle from './LangToggle.astro';

interface Props {
  locale: Locale;
  t: (key: string) => string;
}

const { locale, t } = Astro.props;
const homeHref = locale === 'ro' ? withBase('/') : withBase('/en/');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="monogram" href={homeHref} aria-label="Patricia & Cosmin">
      <span aria-hidden="true">P&nbsp;&amp;&nbsp;C</span>
    </a>
    <LangToggle locale={locale} t={t} />
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 10;
    padding-block: var(--space-lg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .monogram {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 500;
    font-size: var(--step-0);
    letter-spacing: 0.14em;
    color: var(--accent-ink);
    text-decoration: none;
  }

  .monogram:hover,
  .monogram:focus-visible {
    color: var(--ink);
  }
</style>
