---
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props;
---

<div class="scroll-cue" data-scroll-cue aria-hidden="true">
  <span class="scroll-cue__label">{t('scrollCue.label')}</span>
  <svg
    class="scroll-cue__chevron"
    viewBox="0 0 24 14"
    width="22"
    height="13"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M2 2l10 10L22 2"></path>
  </svg>
</div>

<style>
  .scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--brass);
    opacity: 1;
    transition:
      opacity 400ms var(--ease-editorial),
      transform 400ms var(--ease-editorial);
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue {
      animation: cue-in 800ms var(--ease-editorial) 700ms backwards;
    }
  }

  @keyframes cue-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .scroll-cue.is-hidden {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }

  .scroll-cue__label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
</style>

<script>
  const cue = document.querySelector<HTMLElement>('[data-scroll-cue]');
  if (cue) {
    const hide = () => {
      cue.classList.add('is-hidden');
      window.removeEventListener('scroll', onScroll);
    };
    const onScroll = () => {
      if (window.scrollY > 24) hide();
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
