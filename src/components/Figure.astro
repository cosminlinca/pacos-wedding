---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** Imported image asset. Omit for the CSS placeholder (teaser default). */
  src?: ImageMetadata;
  alt?: string;
  /** Aspect ratio as a CSS `aspect-ratio` value, e.g. "3 / 2". Ignored when `fill`. */
  ratio?: string;
  /** Fill a positioned ancestor instead of reserving an aspect ratio. */
  fill?: boolean;
  /** Placeholder monogram text. */
  monogram?: string;
  sizes?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const {
  src,
  alt = '',
  ratio = '3 / 2',
  fill = false,
  monogram = 'P & C',
  sizes = '100vw',
  class: className,
  loading = 'eager',
} = Astro.props;
---

<figure
  class:list={[
    'figure',
    className,
    { 'figure--placeholder': !src, 'figure--fill': fill },
  ]}
  style={fill ? undefined : `--ratio: ${ratio}`}
>
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        sizes={sizes}
        loading={loading}
        decoding="async"
        widths={[640, 960, 1280, 1920, 2560]}
        class="figure__img"
      />
    ) : (
      <div class="figure__placeholder" role="presentation">
        <svg
          class="figure__grain"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
        >
          <filter id="figure-grain">
            <feTurbulence
              type="fractalNoise"
              baseFrequency="0.9"
              numOctaves="2"
              stitchTiles="stitch"
            />
            <feColorMatrix type="saturate" values="0" />
          </filter>
          <rect width="100%" height="100%" filter="url(#figure-grain)" />
        </svg>
        <span class="figure__monogram" aria-hidden="true">
          {monogram}
        </span>
      </div>
    )
  }
</figure>

<style>
  .figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    background: var(--bg-sink);
  }

  .figure--fill {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    width: 100%;
    height: 100%;
  }

  .figure__img,
  .figure__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .figure__img {
    object-fit: cover;
  }

  .figure__placeholder {
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(
        120% 120% at 15% 10%,
        rgb(255 255 255 / 0.55),
        transparent 55%
      ),
      radial-gradient(
        120% 120% at 85% 90%,
        rgb(var(--accent-rgb) / 0.22),
        transparent 60%
      ),
      linear-gradient(160deg, var(--bg) 0%, var(--bg-sink) 55%, #e6dbc6 100%);
  }

  .figure__grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    mix-blend-mode: multiply;
  }

  .figure__monogram {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 360;
    font-size: min(42vw, 34rem);
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: rgb(var(--accent-rgb) / 0.045);
    user-select: none;
    transform: translateY(-4%);
  }

  @media (prefers-reduced-motion: reduce) {
    .figure__grain {
      opacity: 0.35;
    }
  }
</style>
