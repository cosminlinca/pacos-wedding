---
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<section class="std" aria-labelledby="std-heading">
  <div class="container std__inner">
    <p class="eyebrow" data-reveal style="--reveal-index: 0">
      {t('saveTheDate.heading')}
    </p>
    <h2
      class="std__lead"
      id="std-heading"
      data-reveal
      style="--reveal-index: 1"
    >
      {t('saveTheDate.lead')}
    </h2>
    <p class="std__body measure" data-reveal style="--reveal-index: 2">
      {t('saveTheDate.body')}
    </p>
  </div>
</section>

<style>
  .std {
    background: var(--bg-sink);
    border-top: var(--hairline);
    border-bottom: var(--hairline);
    padding-block: clamp(3.5rem, 2rem + 10vw, 7rem);
  }

  .std__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    text-align: center;
  }

  .std__lead {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 400;
    font-optical-sizing: auto;
    font-variation-settings:
      'SOFT' 30,
      'opsz' 72;
    color: var(--ink);
  }

  .std__body {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step-0);
  }
</style>
