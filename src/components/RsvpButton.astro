---
import { RSVP_FORM_URL } from '../lib/invitation';

interface Props {
  t: (key: string) => string;
  /** Header and hero links lead to the RSVP section until the form is ready. */
  section?: boolean;
  outline?: boolean;
}

const { t, section = false, outline = false } = Astro.props;
---

{
  section && !RSVP_FORM_URL ? (
    <button
      class:list={['button', { 'button--outline': outline }]}
      type="button"
      disabled
      aria-describedby="rsvp-pending"
    >
      {t('rsvp.button')}
    </button>
  ) : (
    <a
      class:list={['button', { 'button--outline': outline }]}
      href={RSVP_FORM_URL ?? '#rsvp'}
    >
      {t('rsvp.button')}
    </a>
  )
}
